# ===========================================================================
# Legal RAG AI — environment configuration
# Copy to `.env` and adjust. Every value mirrors a field in
# backend/core/config.py. Defaults shown are the locked decisions (ACTION_PLAN §0).
# ===========================================================================

# -- App identity -----------------------------------------------------------
APP_NAME="Legal RAG AI"
APP_VERSION=1.0.0
DEBUG=false

# -- Deployment -------------------------------------------------------------
DEPLOY_DOMAIN=your-domain.com

# -- Typesense (vector + keyword hybrid search) -----------------------------
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_CONNECTION_TIMEOUT=5
TYPESENSE_PDF_CHUNKS_COLLECTION=pdf_chunks
# Kept for backward compatibility:
TYPESENSE_TASKS_COLLECTION=tasks

# -- Embedding model (ingestion + queries) ----------------------------------
EMBEDDING_MODEL_NAME=yuriyvnv/legal-bge-m3
# EMBEDDING_DEVICE=cpu          # leave unset to auto-select; or "cpu"/"cuda"
EMBEDDING_DIMENSION=1024        # MUST equal the Typesense schema num_dim
EMBEDDING_NORMALIZE=true

# -- LLM provider switch ("gemini" for production, "ollama" for local dev) --
LLM_PROVIDER=gemini

# Sampling temperature. 0.0 = deterministic (same context → same answer).
LLM_TEMPERATURE=0.0

# -- Gemini API (used when LLM_PROVIDER=gemini) ----------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2

# -- Ollama (used when LLM_PROVIDER=ollama) ---------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# -- OCR (PyMuPDF + Tesseract — requires `tesseract-ocr` system package) ----
OCR_ENABLED=true
OCR_MIN_TEXT_LENGTH=50

# -- Storage monitoring -----------------------------------------------------
TYPESENSE_DATA_DIR=typesense-data
DISK_QUOTA_GB=80

# -- MCP server (read-side retrieval tool provider) -------------------------
MCP_SERVER_URL=http://localhost:9000
RETRIEVAL_VIA_MCP=true          # backend-orchestrated by default (Step 3 flips this)

# -- RAG loop ---------------------------------------------------------------
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000

# -- PDF storage + chunking -------------------------------------------------
PDF_STORAGE_DIR=storage/pdfs
PDF_PUBLIC_BASE_URL=
# Chunks split on Article/Section boundaries; smaller cap = sharper per-provision
# embeddings. Re-ingest after changing.
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# -- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800        # 50 MB
ALLOWED_UPLOAD_CONTENT_TYPE=application/pdf

# -- CORS (comma-separated origins; tighten off "*" in production) ----------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Auth (optional) --------------------------------------------------------
# Empty = disabled. Set to require X-API-Key (or Authorization: Bearer) on
# write endpoints (/ingest). deploy.sh also bakes this into the frontend build
# (VITE_API_AUTH_TOKEN) so uploads send the key. Note: a value baked into a
# static SPA is readable in the JS bundle — obfuscation, not a true secret.
API_AUTH_TOKEN=

# -- Rate limiting (single-process seam; disabled by default) ---------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
